    {
      "id": "keyboard.onscreen",
      "name": "Tastiera su schermo",
      "category": "Tastiera",
      "description": "Apre o attiva la tastiera su schermo (OSK) integrata in Windows.",
      "aliases": [
        "tastiera",
        "tastiera virtuale",
        "osk",
        "on screen keyboard",
        "keyboard on screen"
      ],
      "keywords": [
        "accessibilita",
        "input",
        "digitazione",
        "keyboard"
      ],
      "platform": "Windows 10/11",
      "routes": [
        {
          "kind": "HOTKEY",
          "value": "WIN + CTRL + O",
          "handler": "none",
          "executable": false,
          "safety": "SAFE",
          "verified": "Microsoft",
          "source": "https://support.microsoft.com/it-it/accessibility/windows/windows-keyboard-shortcuts-for-accessibility",
          "note": "Scorciatoia Windows per attivare/disattivare la tastiera su schermo."
        },
        {
          "kind": "RUN",
          "value": "osk.exe",
          "handler": "exe",
          "executable": true,
          "safety": "SAFE",
          "verified": "Windows built-in",
          "source": "https://support.microsoft.com/it-it/accessibility/windows/use-the-on-screen-keyboard-osk-to-type",
          "note": "Avvia direttamente la Tastiera su schermo."
        }
      ]
    },
